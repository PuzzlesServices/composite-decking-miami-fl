---
const services = [
  {
    title: 'Low maintenance',
  },
  {
    title: 'Fade resistant',
  },
  {
    title: 'Stain resistant',
  },
  {
    title: 'Scratch resistant',
  },
  {
    title: 'Mold resistant',
  },
  {
    title: 'Sustainable materials',
  },
  {
    title: 'No sanding, staining, or painting required',
  },
];
---

<section id="about-us" class="py-24 relative bg-[#2D0863]">
  <div class="max-w-[1400px] mx-auto px-5 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20">
      <!-- Left Column: Title & Subtitle (Sticky on Desktop) -->
      <div
        class="lg:col-span-5 lg:sticky lg:top-28 self-start space-y-6 text-white"
      >
        <div class="relative">
          <h2 class="text-2xl lg:text-4xl font-light uppercase leading-tight">
            The Smarter<br /> Alternative to Wood
          </h2>

          <div
            class="bg-white/30 min-w-7 min-h-7 flex items-center justify-center rounded-full absolute left-[-40px] top-0"
          >
            <span class="bg-white min-w-3 min-h-3 rounded-full"></span>
          </div>
        </div>
        <p class="text-base sm:text-lg leading-relaxed font-light">
          Composite decking delivers the beauty of natural wood without the
          ongoing maintenance. Designed to withstand Florida's demanding
          climate, composite materials offer exceptional durability, resistance
          to fading, staining, moisture, and mold while maintaining their
          appearance for years.
        </p>
      </div>

      <!-- Right Column: Services List (Numbered & Separated by Line) -->
      <div class="lg:col-span-7 divide-y divide-white">
        {
          services.map((service, index) => {
            const num = String(index + 1).padStart(2, '0');
            return (
              <div class="py-6 sm:py-8 px-8 first:pt-0 last:pb-0 text-white group flex items-center justify-between gap-6 transition-all duration-300">
                <div class="flex items-center gap-16">
                  <span class="text-xl font-medium text-wood-light tracking-wider opacity-60 group-hover:opacity-100 transition-opacity duration-300">
                    {num}
                  </span>
                  <h3 class="text-xl font-light group-hover:text-wood-light group-hover:translate-x-3 transition-all duration-300">
                    {service.title}
                  </h3>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>
