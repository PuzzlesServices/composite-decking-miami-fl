---
const steps = [
  {
    image: '/assets/icons/user-comment.png',
    label: 'Tell us about your project',
  },
  {
    image: '/assets/icons/select-multiple.png',
    label: 'Receive product recommendations',
  },
  {
    image: '/assets/icons/paint-bucket.png',
    label: 'Select colors and materials',
  },
  {
    image: '/assets/icons/chat-round-money-broken.png',
    label: 'Get pricing and estimate',
  },
  {
    image: '/assets/icons/wood.png',
    label: 'Build your dream outdoor space',
  },
];
---

<section id="project-types" class="process-section px-5 py-8 md:py-16">
  <div class="mx-auto flex w-full max-w-3xl flex-col gap-10 sm:gap-16">
    <div
      class="process-title-wrapper flex items-start justify-center gap-3 sm:items-center"
    >
      <div class="process-dot-ring">
        <span class="process-dot-inner"></span>
      </div>
      <h2 class="process-title text-2xl text-[#d65311] uppercase lg:text-4xl">
        Designed for Every Outdoor Space
      </h2>
    </div>

    <!-- Overlapping circles row -->
    <div class="circles-row flex flex-wrap justify-center xl:flex-nowrap">
      {
        steps.map((step) => (
          <div class="circle-item mx-[-10px] my-[-10px] flex h-[180px] w-[180px] flex-col items-center justify-center gap-3 rounded-full border border-dashed border-[#FF5623] p-5 transition-all duration-300 hover:scale-110 sm:my-[-25px] sm:min-h-[250px] sm:min-w-[250px] sm:p-12 xl:my-auto">
            <div class="circle-card">
              <img
                src={step.image}
                alt={step.label}
                class="circle-img h-12 object-contain sm:h-16"
                loading="lazy"
                decoding="async"
              />
            </div>
            <span class="circle-label lg:text-md text-center text-sm">
              {step.label}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .process-dot-ring {
    background: #ffdcb94d;
    min-width: 28px;
    min-height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
  }

  .process-dot-inner {
    background: #d65311;
    min-width: 12px;
    min-height: 12px;
    border-radius: 50%;
  }
</style>
