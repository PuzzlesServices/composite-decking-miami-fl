---

<header class="fixed top-0 right-0 left-0 z-50 bg-[#FE7F03]">
  <div
    class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8"
  >
    <!-- Brand Logo -->
    <img
      src="/assets/composite-decking-miami-fl.webp"
      alt="Composite Decking Miami FL Icon"
      class="h-9 sm:h-12"
    />

    <!-- Navigation Links -->
    <nav
      class="hidden items-center gap-8 text-sm font-light text-white md:flex"
    >
      <a href="#about-us" class="transition-colors hover:text-[#2D0863]"
        >About Us</a
      >
      <a href="#trusted-brands" class="transition-colors hover:text-[#2D0863]"
        >Trusted Brands</a
      >
      <a href="#outdoor-spaces" class="transition-colors hover:text-[#2D0863]"
        >Outdoor Spaces</a
      >
      <a href="#faqs" class="transition-colors hover:text-[#2D0863]">FAQs</a>
      <a href="#contact" class="transition-colors hover:text-[#2D0863]"
        >Contact Us</a
      >
    </nav>

    <!-- Call Action & Phone -->
    <div class="flex items-center gap-4">
      <a
        href="tel:3055553325"
        class="flex items-center gap-2 rounded-full border border-white bg-white px-6 py-2 text-sm text-[#FE7F03]"
      >
        (877) 535-0896
      </a>
    </div>
  </div>
</header>
