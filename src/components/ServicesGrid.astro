---
const items = [
  {
    title: 'Premium Products',
  },
  {
    title: 'Superior Service',
  },
  {
    title: 'Large Local Inventory',
  },
  {
    title: 'Exceptional Prices',
  },
  {
    title: 'Expert Guidance',
  },
  {
    title: 'Florida Climate Expertise',
  },
];
---

<section id="services-grid" class="bg-[#2D0863] px-5 py-8 lg:py-28">
  <div class="services-grid-container">
    <!-- Left: Title & Description -->
    <div class="services-grid-left">
      <h2 class="text-2xl text-[#FE7F03] uppercase lg:text-4xl">
        More Than a Supplier
      </h2>
      <p class="text-md max-w-105 font-light text-white md:text-lg">
        At Composite Decking Miami FL, our goal is to provide customers with the
        best shopping experience through premium products, exceptional pricing,
        and superior service.
      </p>
    </div>

    <!-- Right: 6 Items Grid -->
    <div class="services-grid-right mx-auto max-w-62.5 sm:max-w-full">
      {
        items.map((item) => (
          <div class="flex items-center gap-4 transition-all duration-300 ease-in-out hover:-translate-y-2">
            <img
              src="/assets/icons/check-icon.png"
              alt="Check Icon"
              class="h-10"
              loading="lazy"
            />
            <h3 class="text-white">{item.title}</h3>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services-grid-container {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }
  /* ── Left ── */
  .services-grid-left {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  /* ── Right Grid ── */
  .services-grid-right {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .services-grid-container {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .services-grid-left {
      position: static;
      align-items: center;
      text-align: center;
    }
  }

  @media (max-width: 640px) {
    .services-grid-right {
      grid-template-columns: 1fr;
    }
  }
</style>
