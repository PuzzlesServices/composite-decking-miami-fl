---
const slides = [
  {
    image: '/assets/residential-decks.webp',
    alt: 'Residential Decks',
    title: 'Residential Decks',
  },
  {
    image: '/assets/pool-decks.webp',
    alt: 'Pool Decks',
    title: 'Pool Decks',
  },
  {
    image: '/assets/roof-terraces.webp',
    alt: 'Roof terraces',
    title: 'Roof terraces',
  },
  {
    image: '/assets/marinas.webp',
    alt: 'Marinas',
    title: 'Marinas',
  },
  {
    image: '/assets/waterfront.webp',
    alt: 'Waterfront docks',
    title: 'Waterfront docks',
  },
  {
    image: '/assets/commercial-projects.webp',
    alt: 'Commercial projects',
    title: 'Commercial projects',
  },
  {
    image: '/assets/outdoor-kitchens.webp',
    alt: 'Outdoor kitchens',
    title: 'Outdoor kitchens',
  },
  {
    image: '/assets/patios.webp',
    alt: 'Patios',
    title: 'Patios',
  },
];
---

<section id="outdoor-spaces" class="overflow-hidden px-5 py-8 lg:py-16">
  <div class="mx-auto max-w-350">
    <!-- Header Row -->
    <div
      class="mb-6 flex justify-between border-b border-[#AFAFAF] pb-6 sm:mb-12 sm:pb-10"
    >
      <div class="flex items-start gap-2 sm:items-center sm:gap-6">
        <div
          class="flex min-h-7 min-w-7 items-center justify-center rounded-full bg-[#D65311]/20"
        >
          <span class="min-h-3 min-w-3 rounded-full bg-[#D65311]"></span>
        </div>
        <h2
          class="w-[75%] text-xl leading-tight text-[#D65311] uppercase sm:w-auto sm:text-2xl lg:text-4xl"
        >
          Designed for Every Outdoor Space
        </h2>
      </div>

      <!-- Navigation Controls -->
      <div class="flex flex-shrink-0 items-center gap-3">
        <button
          id="gallery-prev"
          aria-label="Previous slides"
          class="group flex h-12 w-12 items-center justify-center rounded-full border-2 border-[#555555] text-[#555555] transition-all duration-300 hover:bg-[#555555] hover:text-white active:scale-95"
        >
          <svg
            class="h-5 w-5 transition-transform duration-300 group-hover:-translate-x-0.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 19l-7-7 7-7"></path>
          </svg>
        </button>

        <button
          id="gallery-next"
          aria-label="Next slides"
          class="group flex h-12 w-12 items-center justify-center rounded-full border-2 border-[#555555] text-[#555555] transition-all duration-300 hover:bg-[#555555] hover:text-white active:scale-95"
        >
          <svg
            class="h-5 w-5 transition-transform duration-300 group-hover:translate-x-0.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 5l7 7-7 7"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Slider Track Wrapper -->
    <div class="relative overflow-hidden">
      <div
        id="gallery-track"
        class="flex gap-4 transition-transform duration-500 ease-in-out"
      >
        {
          slides.map((slide, index) => (
            <div class="gallery-slide group relative flex-shrink-0 overflow-hidden rounded-2xl">
              <img
                src={slide.image}
                alt={slide.alt}
                class="h-full w-full object-cover object-center transition-transform duration-700 group-hover:scale-105"
                loading={index < 4 ? 'eager' : 'lazy'}
              />

              <div class="absolute bottom-0 left-0 p-5">
                <h3 class="text-base leading-snug font-medium text-white drop-shadow-md lg:text-lg">
                  {slide.title}
                </h3>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Dot Indicators -->
    <div
      class="mt-8 flex justify-center gap-2"
      id="gallery-dots"
      role="tablist"
      aria-label="Gallery page indicators"
    >
      {
        Array.from({ length: Math.ceil(slides.length / 4) }).map((_, index) => (
          <button
            class={`gallery-dot h-1.5 rounded-full transition-all duration-300 ${index === 0 ? 'w-8 bg-[#D65311]' : 'w-1.5 bg-gray-400 hover:bg-gray-500'}`}
            data-index={index}
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-label={`Go to page ${index + 1}`}
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  .gallery-slide {
    width: calc(25% - 12px);
    aspect-ratio: 3 / 4;
  }

  @media (max-width: 1024px) {
    .gallery-slide {
      width: calc(50% - 8px);
    }
  }

  @media (max-width: 640px) {
    .gallery-slide {
      width: 100%;
    }
  }
</style>

<script>
  const track = document.getElementById('gallery-track') as HTMLElement;
  const prevBtn = document.getElementById('gallery-prev') as HTMLButtonElement;
  const nextBtn = document.getElementById('gallery-next') as HTMLButtonElement;
  const dots = document.querySelectorAll<HTMLButtonElement>('.gallery-dot');
  const slides = document.querySelectorAll<HTMLElement>('.gallery-slide');

  let current = 0;

  function getVisibleCount(): number {
    if (window.innerWidth <= 640) return 1;
    if (window.innerWidth <= 1024) return 2;
    return 4;
  }

  function getPages(): number {
    return Math.ceil(slides.length / getVisibleCount());
  }

  function getSlideWidth(): number {
    if (!slides[0]) return 0;
    const gap = 16;
    return slides[0].offsetWidth + gap;
  }

  function goTo(page: number) {
    const pages = getPages();
    current = ((page % pages) + pages) % pages;

    const visibleCount = getVisibleCount();
    const slideWidth = getSlideWidth();
    track.style.transform = `translateX(-${current * visibleCount * slideWidth}px)`;

    dots.forEach((dot, i) => {
      if (i === current) {
        dot.classList.add('w-8', 'bg-[#D65311]');
        dot.classList.remove('w-1.5', 'bg-gray-400');
        dot.setAttribute('aria-selected', 'true');
      } else {
        dot.classList.remove('w-8', 'bg-[#D65311]');
        dot.classList.add('w-1.5', 'bg-gray-400');
        dot.setAttribute('aria-selected', 'false');
      }
    });
  }

  prevBtn?.addEventListener('click', () => goTo(current - 1));
  nextBtn?.addEventListener('click', () => goTo(current + 1));

  dots.forEach((dot) => {
    dot.addEventListener('click', () => goTo(Number(dot.dataset.index)));
  });

  // Touch / swipe
  let touchStartX = 0;
  track?.addEventListener(
    'touchstart',
    (e) => {
      touchStartX = e.touches[0].clientX;
    },
    { passive: true }
  );
  track?.addEventListener(
    'touchend',
    (e) => {
      const diff = touchStartX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 50) diff > 0 ? goTo(current + 1) : goTo(current - 1);
    },
    { passive: true }
  );

  window.addEventListener('resize', () => goTo(current));

  // Auto-play
  let autoPlay = setInterval(() => goTo(current + 1), 5000);
  track?.addEventListener('mouseenter', () => clearInterval(autoPlay));
  track?.addEventListener('mouseleave', () => {
    autoPlay = setInterval(() => goTo(current + 1), 5000);
  });
</script>
